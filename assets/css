:root{
  --amber:#ffb347;
  --green:#7dffb0;
  --ink:#0a0b0d;
  --mono:'JetBrains Mono','SFMono-Regular',Consolas,monospace;
}

*,*::before,*::after{ box-sizing:border-box; }

html,body{ height:100%; }
body{
  margin:0;
  background:#05060a;
  color:#9fb0b8;
  font-family:var(--mono);
  overflow:hidden;
  -webkit-font-smoothing:antialiased;
  overscroll-behavior:none;
}

#stage{
  position:fixed; inset:0;
  width:100%; height:100%;
  display:block;
  touch-action:none;
  cursor:default;
}
body.is-live #stage{ cursor:text; }

.sr-power{
  position:fixed; left:50%; top:16px; transform:translateX(-50%);
  z-index:30; padding:10px 18px;
  font-family:var(--mono); font-size:11px; letter-spacing:.16em;
  background:#0b0f14; color:var(--amber);
  border:1px solid rgba(255,179,71,.45); border-radius:4px;
  cursor:pointer;
  clip-path:inset(50%); width:1px; height:1px; overflow:hidden; white-space:nowrap;
}
.sr-power:focus-visible{
  clip-path:none; width:auto; height:auto; overflow:visible;
  outline:2px solid var(--amber); outline-offset:3px;
}
body.is-live .sr-power{ display:none; }

.keys{
  position:fixed; left:0; right:0; bottom:0; z-index:16;
  display:none; flex-wrap:wrap; gap:6px; justify-content:center;
  padding:10px 10px calc(10px + env(safe-area-inset-bottom));
  background:linear-gradient(to top, rgba(5,6,10,.96), rgba(5,6,10,0));
}
.keys button{
  font-family:var(--mono); font-size:11px; letter-spacing:.06em;
  background:rgba(255,179,71,.06); border:1px solid rgba(255,179,71,.22);
  color:var(--amber); padding:8px 12px; border-radius:4px; cursor:pointer;
}
.keys button:active{ background:rgba(255,179,71,.18); }
body.is-touch.is-live .keys{ display:flex; }

.ghost{
  position:fixed; left:-9999px; top:0; width:1px; height:1px;
  opacity:0; border:0; padding:0;
}

.fallback{
  position:absolute; width:1px; height:1px; padding:0; margin:-1px;
  overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; border:0;
}
body.no-webgl{ overflow:auto; background:#0a0d10; }
body.no-webgl #stage,
body.no-webgl .sr-power,
body.no-webgl .keys{ display:none; }
body.no-webgl .fallback{
  position:static; width:auto; height:auto; margin:0 auto; padding:48px 24px 80px;
  overflow:visible; clip:auto; white-space:normal; max-width:760px;
  color:#b8c7cc; line-height:1.7; font-size:15px;
}
body.no-webgl .fallback h1{ font-size:44px; color:var(--green); letter-spacing:.06em; margin:0 0 4px; }
body.no-webgl .fallback h2{ font-size:16px; color:var(--amber); letter-spacing:.14em;
  text-transform:uppercase; margin:38px 0 10px; }
body.no-webgl .fallback a{ color:var(--green); }
body.no-webgl .fallback li{ margin-bottom:8px; }

body:not(.is-live) #stage{ cursor:pointer; }
